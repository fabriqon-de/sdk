{
  "name": "@fabriqon/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Dependency-free Fabriqon models and DXF import with an optional Three.js viewer",
  "exports": {
    ".": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./drawing": {
      "types": "./dist/drawing.d.ts",
      "import": "./dist/drawing.js"
    },
    "./contracts/sensor-catalog.v1.schema.json": "./contracts/sensor-catalog.v1.schema.json",
    "./contracts/sensor-bindings.v1.schema.json": "./contracts/sensor-bindings.v1.schema.json",
    "./contracts/sensor-state.v1.schema.json": "./contracts/sensor-state.v1.schema.json"
  },
  "files": [
    "dist",
    "examples",
    "docs/api.md",
    "README.md",
    "LICENSE",
    "contracts",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "SUPPORT.md",
    "GOVERNANCE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.core.json && tsc -p tsconfig.json",
    "test": "vitest run test/",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "docs:dev": "npm run build && node scripts/copy-contracts.mjs && vitepress dev docs --host 127.0.0.1",
    "docs:build": "npm run build && node scripts/copy-contracts.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "test:docs": "playwright test --config playwright.docs.config.mjs",
    "test:viewer": "npm run build && playwright test --config playwright.viewer.config.mjs"
  },
  "peerDependencies": {
    "three": "^0.186.0 || ^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.187.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fabriqon-de/sdk.git"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://docs.fabriqon.de/"
}
