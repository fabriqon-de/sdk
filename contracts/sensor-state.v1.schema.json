{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.fabriqon.de/contracts/sensor-state.v1.schema.json",
  "title": "sensor-state v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "fabriqon.sensor-state"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "signalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "streamId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "enum": [
        "measurement",
        "availability",
        "connection"
      ]
    },
    "emittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40
    },
    "sourceConnection": {
      "enum": [
        "connected",
        "disconnected",
        "unknown"
      ]
    },
    "availability": {
      "enum": [
        "online",
        "offline",
        "unknown"
      ]
    },
    "freshness": {
      "enum": [
        "fresh",
        "stale",
        "unknown"
      ]
    },
    "reading": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": [
                "number",
                "boolean",
                "string",
                "null"
              ],
              "maxLength": 1024
            },
            "quality": {
              "enum": [
                "valid",
                "unknown",
                "invalid"
              ]
            },
            "observedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$",
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "receivedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "maxLength": 40
            },
            "retained": {
              "type": "boolean"
            }
          },
          "required": [
            "value",
            "quality",
            "observedAt",
            "receivedAt",
            "retained"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "quality": {
                    "const": "valid"
                  }
                },
                "required": [
                  "quality"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "catalogId",
    "sourceId",
    "signalId",
    "streamId",
    "sequence",
    "reason",
    "emittedAt",
    "sourceConnection",
    "availability",
    "freshness",
    "reading"
  ]
}
