# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=proxy_ca,mode=0444 if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci
COPY . .
RUN npm run docs:build

FROM nginx:1.28-alpine AS runtime
COPY --chown=nginx:nginx --chmod=0644 deploy/docs-nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=nginx:nginx /app/docs/.vitepress/dist /usr/share/nginx/html
COPY --chown=nginx:nginx LICENSE /usr/share/nginx/html/license.txt
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s CMD wget -Y off -qO- http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
